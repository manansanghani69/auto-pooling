        {
          "name": "Verify OTP (Login / Signup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (![200, 201].includes(pm.response.code)) return;",
                  "let payload = null;",
                  "try { payload = pm.response.json(); } catch (_) { return; }",
                  "const tokens = payload?.data?.tokens;",
                  "if (!tokens) return;",
                  "if (tokens.accessToken) pm.environment.set('auth_token', tokens.accessToken);",
                  "if (tokens.refreshToken) pm.environment.set('refresh_token', tokens.refreshToken);",
                  "const expiresIn = String(tokens.expiresIn || '15m').trim();",
                  "const durationMatch = expiresIn.match(/^(\\d+)([smhd])$/i);",
                  "const unitToMs = { s: 1000, m: 60000, h: 3600000, d: 86400000 };",
                  "const expiresMs = durationMatch",
                  "  ? Number(durationMatch[1]) * unitToMs[durationMatch[2].toLowerCase()]",
                  "  : 15 * 60 * 1000;",
                  "pm.environment.set('token_expires_at', String(Date.now() + expiresMs));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{rider_phone}}\",\n  \"otp\": \"1234\",\n  \"name\": \"Rider One\",\n  \"role\": \"rider\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{auth_base_url}}/v1/auth/verify-otp",
            "description": "Verifies OTP, creates user if not present, and returns access + refresh tokens."
          },
