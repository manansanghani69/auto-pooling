    {
      "name": "Driver Location gRPC (Documentation)",
      "description": "gRPC host: {{grpc_host}}",
      "item": [
        {
          "name": "FindNearByDrivers (gRPC Docs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-skip-auto-auth",
                "value": "true"
              }
            ],
            "url": "{{driver_location_base_url}}/v1/driver-location/health",
            "description": "Service: DriverLocation.DriverLocation\\nMethod: FindNearByDrivers(UserLocation) returns (NearByDrivers)\\n\\nRequest schema:\\n{\\n  \"pickUpLongitude\": \"string\",\\n  \"pickUpLatitude\": \"string\",\\n  \"radius\": \"string\"\\n}\\n\\nResponse schema:\\n{\\n  \"drivers\": [\\n    {\\n      \"driverId\": \"string\",\\n      \"longitute\": \"string\",\\n      \"latitude\": \"string\"\\n    }\\n  ]\\n}\\n\\nExample request payload:\\n{\\n  \"pickUpLongitude\": \"72.5714\",\\n  \"pickUpLatitude\": \"23.0225\",\\n  \"radius\": \"5\"\\n}\\n\\nPostman gRPC testing:\\n1) Create a new gRPC request in Postman.\\n2) Server URL: {{grpc_host}}\\n3) Import proto: driver-location/protos/nearby_drivers.proto\\n4) Invoke DriverLocation.DriverLocation/FindNearByDrivers\\n\\ngrpcurl example:\\ngrpcurl -plaintext -import-path driver-location/protos -proto nearby_drivers.proto -d '{\"pickUpLongitude\":\"72.5714\",\"pickUpLatitude\":\"23.0225\",\"radius\":\"5\"}' {{grpc_host}} DriverLocation.DriverLocation/FindNearByDrivers"
          },
          "response": [
            {
              "name": "gRPC Success Example",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"drivers\": [\n    {\n      \"driverId\": \"driver-uuid-1\",\n      \"longitute\": \"72.5714\",\n      \"latitude\": \"23.0225\"\n    },\n    {\n      \"driverId\": \"driver-uuid-2\",\n      \"longitute\": \"72.5801\",\n      \"latitude\": \"23.0310\"\n    }\n  ]\n}"
            },
            {
              "name": "gRPC INVALID_ARGUMENT Example",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"code\": 3,\n  \"message\": \"validation error\",\n  \"details\": \"pickUpLatitude: pickUpLatitude is required\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Request Trip WebSocket (Documentation)",
      "description": "Socket path: /ws/request-trip",
      "item": [
        {
          "name": "WebSocket Connection Config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-skip-auto-auth",
                "value": "true"
              }
            ],
            "url": "{{socket_url}}/ws/request-trip?token={{auth_token}}",
            "description": "Handshake URL: {{socket_url}}/ws/request-trip?token={{auth_token}}\\nAlternative auth: Authorization: Bearer <access_token> header in websocket upgrade request.\\n\\nInitial server event after successful auth:\\n{\\n  \"event\": \"connection.ready\",\\n  \"data\": {\\n    \"userId\": \"<uuid>\",\\n    \"role\": \"rider|driver\",\\n    \"path\": \"/ws/request-trip\"\\n  },\\n  \"meta\": { \"requestId\": \"<uuid>\" }\\n}"
          },
          "response": [
            {
              "name": "connection.ready",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"event\": \"connection.ready\",\n  \"data\": {\n    \"userId\": \"b1548e9f-8df1-4532-b5de-c9cdf8f290c8\",\n    \"role\": \"rider\",\n    \"path\": \"/ws/request-trip\"\n  },\n  \"meta\": {\n    \"requestId\": \"7c14c0f5-8856-4430-b74e-f48beefb95ca\"\n  }\n}"
            },
            {
              "name": "Unauthorized Close",
              "status": "Unauthorized",
              "code": 401,
              "body": "WebSocket closed with code 4401 and reason 'Unauthorized'."
            }
          ]
        },
