{
  "info": {
    "_postman_id": "7b5f25f5-f5db-4c35-9d2d-b8fd506d8f40",
    "name": "Autopool Backend - Combined API Collection",
    "description": "Combined collection for all backend microservices: auth, profile, driver-location, and request-trip (REST + gRPC/WebSocket documentation).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.1.0"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const skipAuth = String(pm.request.headers.get('x-skip-auto-auth') || '').toLowerCase() === 'true';",
          "if (skipAuth) {",
          "  pm.request.headers.remove('x-skip-auto-auth');",
          "  return;",
          "}",
          "",
          "const requestUrl = pm.request.url.toString();",
          "const authExemptPaths = [",
          "  '/health',",
          "  '/v1/auth/request-otp',",
          "  '/v1/auth/verify-otp',",
          "  '/v1/auth/refresh'",
          "];",
          "const isAuthExempt = authExemptPaths.some((path) => requestUrl.includes(path));",
          "",
          "if (!isAuthExempt) {",
          "  const currentToken = pm.environment.get('auth_token');",
          "  if (currentToken) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${currentToken}` });",
          "  }",
          "}",
          "",
          "const expiresAt = Number(pm.environment.get('token_expires_at') || 0);",
          "const refreshToken = pm.environment.get('refresh_token');",
          "const authBaseUrl = pm.environment.get('auth_base_url');",
          "const shouldRefresh = Boolean(expiresAt && refreshToken && authBaseUrl && Date.now() >= expiresAt - 30000);",
          "",
          "if (shouldRefresh) {",
          "  pm.sendRequest(",
          "    {",
          "      url: `${authBaseUrl}/v1/auth/refresh`,",
          "      method: 'POST',",
          "      header: { 'Content-Type': 'application/json' },",
          "      body: { mode: 'raw', raw: JSON.stringify({ refreshToken }) }",
          "    },",
          "    (error, response) => {",
          "      if (error || !response) return;",
          "      if (response.code !== 200) return;",
          "      let payload = null;",
          "      try {",
          "        payload = response.json();",
          "      } catch (_) {",
          "        return;",
          "      }",
          "      const tokenData = payload?.data || {};",
          "      if (tokenData.accessToken) pm.environment.set('auth_token', tokenData.accessToken);",
          "      if (tokenData.refreshToken) pm.environment.set('refresh_token', tokenData.refreshToken);",
          "      const accessTokenLifetimeMs = 15 * 60 * 1000;",
          "      pm.environment.set('token_expires_at', String(Date.now() + accessTokenLifetimeMs));",
          "    }",
          "  );",
          "}"
        ]
      }
    }
  ],
