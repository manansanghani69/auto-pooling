{
  "info": {
    "_postman_id": "6673a594-d0ee-4df8-a966-bf1538bab8c2",
    "name": "Autopool Profile Service API",
    "description": "Profile microservice endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.url.toString().includes('/health')) return;",
          "const token = pm.environment.get('auth_token');",
          "if (token) pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/v1/profile/health"
      }
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/v1/profile"
      }
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rider One Updated\",\n  \"email\": \"rider.updated@example.com\",\n  \"photo_link\": \"https://cdn.example.com/riders/rider-updated.jpg\",\n  \"gender\": \"male\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/v1/profile"
      }
    },
    {
      "name": "Create Rider User",
      "request": {
