{
  "info": {
    "_postman_id": "394dc72e-88a6-4dd5-9b3f-93ec8068ef16",
    "name": "Autopool Driver Location Service API",
    "description": "Driver-location microservice REST + gRPC docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestUrl = pm.request.url.toString();",
          "if (requestUrl.includes('/health')) return;",
          "if (requestUrl.includes('/grpc-docs')) return;",
          "const token = pm.environment.get('auth_token');",
          "if (token) pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "grpc_host",
      "value": "localhost:50051"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/v1/driver-location/health"
      }
    },
    {
      "name": "Update Driver Location",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"longitude\": \"72.5714\",\n  \"latitude\": \"23.0225\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/v1/driver-location"
      }
    },
    {
      "name": "FindNearByDrivers gRPC (Docs)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-skip-auto-auth",
            "value": "true"
          }
        ],
        "url": "{{base_url}}/grpc-docs",
        "description": "Service: DriverLocation.DriverLocation\\nRPC: FindNearByDrivers(UserLocation) returns (NearByDrivers)\\n\\nRequest JSON representation:\\n{\\n  \"pickUpLongitude\": \"72.5714\",\\n  \"pickUpLatitude\": \"23.0225\",\\n  \"radius\": \"5\"\\n}\\n\\nResponse JSON representation:\\n{\\n  \"drivers\": [\\n    {\\n      \"driverId\": \"driver-uuid\",\\n      \"longitute\": \"72.5714\",\\n      \"latitude\": \"23.0225\"\\n    }\\n  ]\\n}\\n\\ngrpcurl:\\ngrpcurl -plaintext -import-path driver-location/protos -proto nearby_drivers.proto -d '{\"pickUpLongitude\":\"72.5714\",\"pickUpLatitude\":\"23.0225\",\"radius\":\"5\"}' {{grpc_host}} DriverLocation.DriverLocation/FindNearByDrivers"
      }
    }
  ]
}
